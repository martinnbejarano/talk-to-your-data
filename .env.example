# Copiá este archivo a `.env` y completá los valores. `.env` está en .gitignore:
# ninguna credencial se versiona.

# --- Base restaurada (rol administrador) ------------------------------------
# Lo usa `apply_bootstrap()` para aplicar `infra/bootstrap.sql`, la suite de
# tests para leer el catálogo, y `scripts/smoke_check.py` para la verificación
# de humo. Los tres pasan por `core/config.py`: la resolución del entorno está
# escrita una sola vez.
# Alcanza con DATABASE_URL; si no está, se arma con las PG* de abajo.
#
# Los valores de abajo son los defaults reales de `core/config.py`, que son los
# del `docker-compose.yml` — versionado, así que no hay secreto que proteger.
# Con el compose recién levantado, este bloque se puede dejar tal cual.
DATABASE_URL=
PGHOST=localhost
PGPORT=55432
PGUSER=postgres
PGPASSWORD=compliance
PGDATABASE=compliance

# --- Rol del agente (sólo lectura, sujeto a RLS) -----------------------------
# El password lo crea el bootstrap: no hay un valor "correcto" que copiar,
# lo elegís vos acá y el script lo aplica al rol. Éste sí **no tiene default**:
# uno conocido sería una credencial con lectura sobre toda la base.
AGENT_RO_USER=agent_ro
AGENT_RO_PASSWORD=

# --- El modelo -------------------------------------------------------------
# Los lee `core/config.py` —`modelo()` y `openai_api_key()`— y de ahí los toma
# `agent/loop.py`. Ninguno de los dos tiene default: el nombre del modelo es
# parte de la configuración, y un default lo convertiría en una medición que no
# se puede repetir. Cambiar de modelo es cambiar esta línea, no una de código.
OPENAI_API_KEY=
OPENAI_MODEL=
