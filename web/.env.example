# Copiá este archivo a `web/.env.local` si necesitás cambiar algún valor. Los dos
# tienen default en `src/config.js`, así que con el backend en el puerto 8000 el
# front arranca sin ningún archivo de entorno.

# La base de `GET /instituciones`, `POST /ask` y `GET /auditoria/{traza_id}`.
VITE_API_URL=http://localhost:8000

# Todo "hoy", "este año" y "último trimestre" se interpreta contra esta fecha y
# nunca contra el reloj. Es una copia de `core.config.AS_OF`: el contrato hoy no
# la trae y la pantalla tiene que mostrarla siempre.
VITE_FECHA_DE_CORTE=2026-06-01
